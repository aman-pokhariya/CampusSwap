# Frontend settings for production builds. Local development needs none of them: Vite proxies /api and
# /socket.io to the API (vite.config.js). On Vercel, add them under Project → Settings → Environment
# Variables, then redeploy: Vite bakes them into the bundle at build time.

# Live chat server. Vercel's /api rewrite (vercel.json) can't proxy WebSockets, so in production the
# browser connects to the API on Render directly. Set this to the Render URL, e.g.
# https://campusswap-api.onrender.com (and Render's CLIENT_URL must be this site's exact URL).
VITE_SOCKET_URL=

# Leave VITE_API_URL unset. The app calls /api on its own origin, which vercel.json forwards to Render;
# that keeps the login cookie first-party. Pointing it straight at Render would break logins.
# VITE_API_URL=
