# Copy this file to .env (same folder) and fill in the values. Never commit .env.

# ── Server ───────────────────────────────────────────────
PORT=8084
NODE_ENV=development
# Frontend URL(s) allowed to call the API, comma-separated
CLIENT_URL=http://localhost:5173

# ── Database: MongoDB Atlas → Connect → Drivers → copy the string ──
# Put the database name (campusswap) right after ".net/"
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/campusswap?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────────
# Any long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Email (Gmail + App Password) ─────────────────────────
# Optional in development: leave empty and OTP codes are printed in the backend terminal.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="CampusSwap <your.email@gmail.com>"

# ── Email in production (Render's free plan blocks SMTP) ─
# Brevo (free, 300 emails/day): brevo.com → SMTP & API → API keys. When BREVO_API_KEY is set it is
# used instead of EMAIL_USER/EMAIL_PASS, and EMAIL_FROM must be a sender you verified in Brevo.
BREVO_API_KEY=
# Most sign-up/reset emails the server sends per day (keep it under your provider's quota)
EMAIL_DAILY_CAP=280

# ── Photos: Cloudinary (needed in production; the free plan is enough) ─
# cloudinary.com → Dashboard. Without these, photos are saved in backend/uploads (development only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Production settings ─────────────────────────────────
# Proxies in front of the API: 1 on Render alone, 2 when Vercel forwards /api to Render
TRUST_PROXY=1
# Reports from accounts younger than this many hours don't count towards auto-hiding a listing
# (leave empty for the default: 72 in production, 0 in development)
REPORT_MIN_ACCOUNT_AGE_HOURS=
