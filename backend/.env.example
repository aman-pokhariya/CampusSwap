# Copy this file to .env (same folder) and fill in the values. Never commit .env.

# ── Server ───────────────────────────────────────────────
PORT=8084
NODE_ENV=development
# Frontend URL(s) allowed to call the API, comma-separated
CLIENT_URL=http://localhost:5173

# ── Database: MongoDB Atlas → Connect → Drivers → copy the string ──
# Put the database name (campusswap) right after ".net/"
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/campusswap?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────────
# Any long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Email (Gmail + App Password) ─────────────────────────
# Optional in development: leave empty and OTP codes are printed in the backend terminal.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="CampusSwap <your.email@gmail.com>"
